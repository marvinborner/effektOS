import ui/pixel
import ui/layout
import ui/window
import ui/default
import system/calls
import system/process

import apps/ipc
import apps/clock
import apps/edit
import apps/team
import apps/kalkulator

type Event {
  Spawn(app: App)
}

interface Model {
  def spawn(app: App): Unit
}

def dispatch(event: Event): Unit / Model = event match {
  case Spawn(app) => do Model::spawn(app)
}

def view() = {
  with padded
  with grid(4)
  with colors(text = colors::white, background = colors::magenta)
  button(Spawn(ipc::app()), "Demo")
  button(Spawn(clock::app()), "Clock")
  button(Spawn(edit::app()), "Edit")
  button(Spawn(team::app()), "Team")
  button(Spawn(kalkulator::app()), "Kalk")
}

def model { view: => Unit / Model }: Unit / Apps =
  try view()
  with Model {
    def spawn(app) = {
      do IPC::spawn(app)
      resume(())
    }
  }

def start(): Unit / { System, WindowManager, Apps } = {
  with val DefaultWindow(window, font) = default::window("App Menu", colors::black)
  with colors(text = colors::white, background = colors::black)
  with sizes(fontSize = 24, padding = 12.0, gap = 6.0)
  with model
  with layouting(window) { event => dispatch(event) }
  view()
}

def app(): App = App(box start)
