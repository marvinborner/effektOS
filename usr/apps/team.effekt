import ui/bmp
import ui/pixel
import ui/vector
import ui/window
import ui/default
import ui/truetype
import ui/geometry
import ui/compositor
import system/calls
import system/filesystem

val TEAM = "/res/group_jumping.bmp"

def start(): Unit / { System, WindowManager } = {
  with val DefaultWindow(window, font) = default::window("Effekt Team", colors::green)

  val image = do open(TEAM).contents.bmp::decode()
  val size = image.size
  do resize(window, size + INSET)

  val area = size.inBody(window)
  area.geometry.bmp::render(image, Vector(0.0, 0.0))
  do dirty(window, area)
}
