import ui/bmp
import ui/pixel
import ui/vector
import ui/window
import ui/default
import ui/truetype
import ui/geometry
import ui/compositor
import system/calls
import system/filesystem

val TEAM = "/res/group_jumping.bmp"

def start(): Unit / { System, WindowManager, IPC } = {
  with val DefaultWindow(window, font) = default::window("Effekt Team", colors::green)

  val image = do open(TEAM).contents.bmp::decode()
  val body: Ref[Option[Context]] = None().ref

  var area = Vector(0.0, 0.0).inBody(window)

  def draw(size: Vector): Unit = {
    do remove(window, area)
    area = size.inBody(window)
    area.geometry.bmp::render(image, (size - image.size - INSET) / 2.0)
    body.set(Some(area))
    do dirty(window, area)
  }

  do resize(window, image.size + INSET)
  draw(image.size)

  try listen()
  with event {
    case Resize(size) => {
      draw(size)
      resume(())
    }
    case Exit() => do destroy(window)
    case _ => resume(())
  }
}

def app(): App = box start
