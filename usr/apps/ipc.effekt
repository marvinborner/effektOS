import ui/rect
import ui/pixel
import ui/alert
import ui/vector
import ui/window
import ui/default
import ui/truetype
import ui/geometry
import ui/compositor
import system/calls
import system/process

val AREA = Vector(300.0, 50.0)
val MESSAGE = 30

def start(): Unit / { System, WindowManager, Apps } = {
  val pid = do current()
  with val DefaultWindow(window, font) = default::window(s"IPC Demo", colors::blue)

  var area = AREA.inBody(window)
  def draw(text: String): Unit = {
    do remove(window, area)
    area = AREA.inBody(window)
    area.geometry.write(Vector(MARGIN, MARGIN), MESSAGE, text, colors::black)
    do dirty(window, area)
  }

  do resize(window, Vector(300.0, 150.0))

  try listen([OnResize(), OnClick(), OnMessage(), OnExit()])
  with event {
    case Resize(size) => {
      val others = do query("IPC Demo")
      others.foreach { process =>
        do send(process, Message(s"${size.x.toInt.show}x${size.y.toInt.show}"))
      }
      resume(())
    }
    case Message(text) => resume(draw(s"focused size: ${text}"))
    case Click(position) => resume(alert(s"Click!"))
    case Exit() => do destroy(window)
    case _ => resume(())
  }
}

def app(): App = App(box start)
