import map

import ui/window

/// `run` runs app with appropriate handlers (`System` and `WindowManager`, in particular)
def apps(boot: List[App]) { run: (App) => Unit / IPC } { handlers: => Nothing / IPC }: Nothing = region scheduler {
  // k is reified, therefore not quite unlike a queue
  var queue: Map[WindowId, EventKind => Unit at {scheduler, run, global, io}] in scheduler = map::empty(box compareInt)

  def forward(window: Window, event: EventKind): Unit = {
    // TODO: never drop (inbox)
    with val app = queue.get(window.id).foreach
    queue = queue.delete(window.id)
    app(event)
  }

  def start(app: App): Option[Window] = {
    var started: Option[Window] in scheduler = None()

    try run(app)
    with IPC {
      def spawn(_app) = resume(start(_app))
      def send(window, event) = resume(forward(window, event))
      def receive(window) = {
        started = Some(window)
        queue = queue.put(window.id, box resume)
        // no resume!
      }
    }
    started
  }

  boot.foreach { app =>
    start(app)
    ()
  }

  try handlers()
  with IPC {
    def spawn(app) = resume(start(app))
    def send(window, event) = resume(forward(window, event))
    def receive(window) = <> // TODO ?
  }
}
