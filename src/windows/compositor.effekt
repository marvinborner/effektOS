import utils

import ui/compositor
import ui/geometry
import ui/vector
import ui/pixel
import ui/rect
import ui/bmp

import capabilities/filesystem
import drivers

import system/calls
import system/graphics
import system/filesystem

import io/error
import set
import map

record Composited(position: Vector, context: Context)

namespace cursor {
  val size = Vector(16.0, 16.0)
  val color = colors::black.fade(0.5)
  def bounds(at: Vector) = Rect(at, size)
}

def wallpaper(size: Vector, depth: Int): Geometry / System = {
  with on[WrongFormat].panic()
  with on[IOError].panic()
  val image = do open("/res/logo.bmp").contents.bmp::decode()
  val background = geometry(size, depth)
  background.fill(colors::white)
  background.bmp::render(image, (size - image.size) / 2.0)
  background
}

def compositor { wm: => Nothing / Compositor }: Nothing / { Output, System } = {
  var counter = 0
  val dirty = set::empty[ContextId](box compareInt).ref
  val focused = set::empty[ContextId](box compareInt).ref
  val composited = map::empty[ContextId, Composited](box compareInt).ref
  val repaint = rect::empty.ref

  val pointer = (Vector(0.0, 0.0) - cursor::size).ref

  val GPUContext(pitch, depth, width, height, gpuBuffer) = do gpuContext()
  val screen = Geometry(Vector(width.toDouble, height.toDouble), depth, gpuBuffer)

  def flush() = do framebuffer(Redraw(gpuBuffer))

  def bounds(id: ContextId): Rect = composited.get.get(id) match {
    case None() => rect::empty
    case Some(Composited(position, context)) => context.geometry.bounds(position)
  }

  val background = wallpaper(screen.size, depth)

  def compose(area: Rect): Unit = {
    screen.overlay(background, Vector(0.0, 0.0), area) // reset area first
    // TODO: leak fewer implementation details (map ordering)
    composited.get.foreach(focused.get) { c =>
      screen.overlay(c.context.geometry, c.position, area)
    }
    screen.rectangle(cursor::bounds(pointer.get), cursor::color, area)
  }

  compose(screen.bounds)
  flush()

  try wm()
  with Compositor {
    def resolution() = resume(screen.size)

    def freshContext(at, size) = {
      counter = counter + 1
      val context = Context(counter, geometry(size, depth))
      composited.map { c => c.put(counter, Composited(at, context)) }
      resume(context)
    }

    // TODO: missing value exception
    def markDirty(id) = resume { dirty.map { d => d.set::insert(id) } }

    def focus(contexts) = {
      def raise(ids: Set[ContextId]) =
        with val id = ids.set::foreach
        dirty.map { d => d.set::insert(id) }
      focused.get.raise
      focused.set(contexts.set::fromList(box compareInt))
      focused.get.raise
      resume(())
    }

    def move(id, by) = resume {
      val Composited(position, context) = composited.get.get(id).value
      repaint.map { d => cover(d, context.geometry.bounds(position)) }
      composited.map { c => c.put(id, Composited(position + by, context)) }
      dirty.map { d => d.set::insert(id) }
    }

    def cursor(at) = {
      repaint.map { d => cover(d, cover(cursor::bounds(pointer.get), cursor::bounds(at))) }
      pointer.set(at)
      resume(())
    }

    def redrawDirty() = {
      var area = repaint.get
      repaint.set(rect::empty)
      dirty.get.foreach { id => area = cover(area, id.bounds) }
      if (area.empty?) resume(())
      else {
        compose(area)
        dirty.set(set::empty[ContextId](box compareInt))
        resume(flush())
      }
    }

    // TODO: missing value exception
    def destroy(id) = resume {
      val area = cover(repaint.get, id.bounds)
      repaint.set(rect::empty)
      composited.map { c => c.map::delete(id) }
      dirty.map { d => d.set::delete(id) }
      focused.map { f => f.set::delete(id) }
      compose(area)
      flush()
    }
  }
}
