import utils

import ui/compositor
import ui/geometry
import ui/vector
import ui/pixel
import ui/rect
import ui/bmp

import capabilities/filesystem
import drivers

import system/calls
import system/graphics
import system/filesystem

import io/error
import set
import map

record Composited(group: GroupId, position: Vector, context: Context)

namespace cursor {
  val size = Vector(16.0, 16.0)
  val color = colors::black.fade(0.5)
  def bounds(at: Vector) = Rect(at, size)
}

def wallpaper(size: Vector, depth: Int): Geometry / System = {
  with on[WrongFormat].panic()
  with on[IOError].panic()
  val image = do open("/res/logo.bmp").contents.bmp::decode()
  val background = geometry(size, depth)
  background.fill(colors::white)
  background.bmp::render(image, (size - image.size) / 2.0)
  background
}

def compositor { wm: => Nothing / Compositor }: Nothing / { Output, System } = {
  var contextCounter = 0
  var groupCounter = 0
  val dirty = set::empty[ContextId](box compareInt).ref
  val composited = map::empty[ContextId, Composited](box compareInt).ref
  val grouped = map::empty[GroupId, List[ContextId]](box compareInt).ref
  val stack: Ref[List[GroupId]] = Nil().ref // bottom to top
  val repaint = rect::empty.ref

  val pointer = (Vector(0.0, 0.0) - cursor::size).ref

  val GPUContext(pitch, depth, width, height, gpuBuffer) = do gpuContext()
  val screen = Geometry(Vector(width.toDouble, height.toDouble), depth, gpuBuffer)

  def flush(area: Rect) = {
    val visible = intersection(area, screen.bounds)
    if (not(visible.empty?))
      do framebuffer(Redraw(gpuBuffer, visible.left, visible.top,
                            visible.right - visible.left, visible.bottom - visible.top))
  }

  def bounds(id: ContextId): Rect = composited.get.get(id) match {
    case None() => rect::empty
    case Some(Composited(_, position, context)) => context.geometry.bounds(position)
  }

  def contexts(group: GroupId): List[ContextId] = grouped.get.get(group).getOrElse { Nil() }

  def destroy(id: ContextId): Unit = {
    repaint.map { d => cover(d, id.bounds) }
    dirty.map { d => d.set::delete(id) }
    composited.map { c => c.map::delete(id) }
  }

  val background = wallpaper(screen.size, depth)

  def compose(area: Rect): Unit = {
    screen.overlay(background, Vector(0.0, 0.0), area) // reset area first
    stack.get.foreach { group =>
      with val id = group.contexts.foreach
      with val c = composited.get.get(id).foreach
      screen.overlay(c.context.geometry, c.position, area)
    }
    screen.rectangle(cursor::bounds(pointer.get), cursor::color, area)
  }

  compose(screen.bounds)
  flush(screen.bounds)

  try wm()
  with Compositor {
    def resolution() = resume(screen.size)

    def createGroup() = {
      groupCounter = groupCounter + 1
      grouped.map { g => g.put(groupCounter, Nil()) }
      stack.map { s => s.append([groupCounter]) }
      resume(groupCounter)
    }

    def createContext(group, at, size) = resume {
      contextCounter = contextCounter + 1
      val context = Context(contextCounter, geometry(size, depth))
      composited.map { c => c.put(contextCounter, Composited(group, at, context)) }
      val others = grouped.get.get(group).value
      grouped.map { g => g.put(group, others.append([contextCounter])) }
      context
    }

    // TODO: missing value exception
    def markDirty(id) = resume { dirty.map { d => d.set::insert(id) } }

    def focus(group) = resume {
      val raised = grouped.get.get(group).value
      stack.map { s => s.filter { g => g != group }.append([group]) }
      raised.foreach { id => dirty.map { d => d.set::insert(id) } }
    }

    def move(id, by) = resume {
      val Composited(group, position, context) = composited.get.get(id).value
      repaint.map { d => cover(d, context.geometry.bounds(position)) }
      composited.map { c => c.put(id, Composited(group, position + by, context)) }
      dirty.map { d => d.set::insert(id) }
    }

    def resize(id, size) = resume {
      val Composited(group, position, context) = composited.get.get(id).value
      repaint.map { d => cover(d, context.geometry.bounds(position)) }
      val resized = Context(id, geometry(size, depth))
      composited.map { c => c.put(id, Composited(group, position, resized)) }
      dirty.map { d => d.set::insert(id) }
      resized
    }

    def cursor(at) = {
      repaint.map { d => cover(d, cover(cursor::bounds(pointer.get), cursor::bounds(at))) }
      pointer.set(at)
      resume(())
    }

    def redrawDirty() = {
      var area = repaint.get
      repaint.set(rect::empty)
      dirty.get.foreach { id => area = cover(area, id.bounds) }
      if (area.empty?) resume(())
      else {
        compose(area)
        dirty.set(set::empty[ContextId](box compareInt))
        resume(flush(area))
      }
    }

    // TODO: missing value exception
    def destroyContext(id) = resume {
      composited.get.get(id).foreach { c =>
        grouped.map { g => g.put(c.group, c.group.contexts.filter { m => m != id }) }
      }
      id.destroy()
      // not immediatly flushed!
    }

    def destroyGroup(id) = resume {
      grouped.get.get(id).value.foreach { id => id.destroy() }
      grouped.map { g => g.map::delete(id) }
      stack.map { s => s.filter { g => g != id } }
    }
  }
}
