import windows/compositor
import ui/compositor
import ui/geometry
import ui/truetype
import ui/window
import ui/vector
import ui/pixel
import ui/rect
import drivers

import utils
import map

val CASCADE = 48.0

record Managed(
  window: Window,
  position: Vector,
  size: Vector,
  title: String,
  accent: Color,
  frame: Context,
  contexts: List[Context]
)

type Action {
  NoAction();
  Moving(window: WindowId, inside: Vector)
  Resizing(window: WindowId)
}

def manager(?font: Font) { inputs: => Nothing / Input } { apps: { {IPC} => Nothing } => Nothing / WindowManager }: Nothing / Compositor = {
  with on[MissingValue].panic()

  var counter = 0

  val screen = do resolution()

  val managed = map::empty[WindowId, Managed](box compareInt).ref
  val pointer = ((screen - cursor::size) / 2.0).ref
  val action = NoAction().ref
  val cascading = Vector(CASCADE, CASCADE).ref
  val focused: Ref[Option[WindowId]] = None().ref

  def lookup(id: WindowId): Option[Managed] = managed.get.get(id)
  def store(m: Managed): Unit = managed.map { ms => ms.put(m.window.id, m) }

  def focused?(window: WindowId): Bool =
    with on[MissingValue].default { false }
    focused.get.value == window

  def raise(m: Managed): Unit = {
    focused.set(Some(m.window.id))
    do focus(Cons(m.frame, m.contexts).map { c => c.id })
  }

  def frame(at: Vector, size: Vector, title: String, accent: Color): Context = {
    val context = do freshContext(at, size)
    window::frame(context.geometry, title, accent)
    do markDirty(context.id)
    context
  }

  def cascade(size: Vector): Vector = {
    val limit = Vector(max(0.0, screen.x - size.x), max(0.0, screen.y - size.y))
    val candidate = cascading.get
    val at = if (candidate.x > limit.x || candidate.y > limit.y) Vector(CASCADE, CASCADE) else candidate
    cascading.set(at + CASCADE)
    clamp(at, limit)
  }

  def topmostAt(position: Vector): Option[Window] = {
    def hit?(m: Managed) = Rect(m.position, m.size).contains?(position)

    val top = focused.get match {
      case Some(id) => lookup(id).filter {hit?}
      case None() => None()
    }
    // TODO: leak fewer implementation details (map ordering)
    top.orElse { managed.get.findReversed {hit?} }.map { m => m.window }
  }

  def move(m: Managed, to: Vector): Unit = {
    val by = to - m.position
    if (to == m.position) ()
    else {
      m.contexts.foreach { c => do compositor::move(c.id, by) }
      do compositor::move(m.frame.id, by)
      store(Managed(m.window, to, m.size, m.title, m.accent, m.frame, m.contexts))
    }
  }

  // TODO: clip underlying contexts
  def resize(m: Managed, _size: Vector): Vector = {
    val size = max(_size, Vector(50.0, 50.0))
    val frame = do freshContext(m.position, size)
    window::frame(frame.geometry, m.title, m.accent)
    do markDirty(frame.id)
    do compositor::destroy(m.frame.id)
    // m.contexts.foreach { c => do compositor::destroy(c.id) } // TODO: m.contexts = []?
    managed.map { ms =>
      ms.put(m.window.id,
        Managed(m.window, m.position, size, m.title, m.accent, frame, m.contexts))
    }
    size
  }

  def drag() {ipc: IPC}: Unit = action.get match {
    case NoAction() => ()
    case Moving(id, inside) => lookup(id) match {
      case None() => action.set(NoAction())
      case Some(m) => m.move(clamp(pointer.get - inside, screen - m.size))
    }
    case Resizing(id) => lookup(id) match {
      case None() => action.set(NoAction())
      case Some(m) => {
        val resized = m.resize(pointer.get - m.position)
        ipc.send(m.window, Resize(resized))
      }
    }
  }

  def leftClick(): Unit = action.get match {
    case Moving(_, _) => () // already moving
    case Resizing(_) => () // currently resizing
    case NoAction() =>
      with val window = topmostAt(pointer.get).foreach
      with val m = lookup(window.id).foreach
      action.set(Moving(window.id, pointer.get - m.position))
      if (not(focused?(window.id))) raise(m)
  }

  def rightClick(): Unit = action.get match {
    case Resizing(_) => () // already resizing
    case Moving(_, _) => () // currently moving
    case NoAction() =>
      with val window = topmostAt(pointer.get).foreach
      with val m = lookup(window.id).foreach
      action.set(Resizing(window.id))
      if (not(focused?(window.id))) raise(m)
  }

  def handlers() {ipc: IPC}: Nothing = {
    try inputs()
    with keyboard {
      case Press(ch) => resume(())
    }

    with mouse {
      case Click(left, middle, right) => {
        if (left) leftClick()
        else if (right) rightClick()
        else action.set(NoAction())
        resume(())
      }
      case Move(x, y) => {
        pointer.set(clamp(pointer.get + Vector(x, 0.0 - y), screen - cursor::size))
        do cursor(pointer.get)
        drag() {ipc}
        resume(())
      }
    }
    with tick { resume(do compositor::redrawDirty()) }
  }

  try apps {handlers}
  with WindowManager {
    def create(size, title, accent) = {
      counter = counter + 1
      val window = Window(counter)
      val at = cascade(size)
      val frame = frame(at, size, title, accent)
      val m = Managed(window, at, size, title, accent, frame, [])
      m.store()
      m.raise()
      resume(window)
    }

    def size(window) = resume { lookup(window.id).value.size }

    def resize(window, size) = resume {
      val m = lookup(window.id).value
      val resized = m.resize(size)
      ()
    }

    def context(window, position, size) = resume {
      val m = lookup(window.id).value
      val context = do freshContext(m.position + position, size)
      val updated = Managed(m.window, m.position, m.size, m.title, m.accent, m.frame, m.contexts.append([context]))
      updated.store()
      if (window.id.focused?) updated.raise() // keep all focused
      context
    }

    def dirty(window, context) = resume {
      val m = lookup(window.id).value
      if (not(m.contexts.contains(context) { (a, b) => a.id == b.id }))
        missingValue()
      do markDirty(context.id)
    }

    def destroy(window) = resume {
      val m = lookup(window.id).value
      m.contexts.foreach { c => do compositor::destroy(c.id) }
      do compositor::destroy(m.frame.id)
      managed.map { ms => ms.map::delete(window.id) }
      if (window.id.focused?) focused.set(None())
      action.get match {
        case NoAction() => ()
        case Moving(id, _) => if (id == window.id) action.set(NoAction())
        case Resizing(id) => if (id == window.id) action.set(NoAction())
      }
    }

    def remove(window, context) = resume {
      val m = lookup(window.id).value
      val updated = m.contexts.filter { c => c.id != context.id }
      if (updated.size == m.contexts.size) // TODO
        missingValue()
      do compositor::destroy(context.id)
      store(Managed(m.window, m.position, m.size, m.title, m.accent, m.frame, updated))
    }

    def at(position) = resume { topmostAt(position).value }
  }
}
