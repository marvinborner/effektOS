import windows/compositor
import ui/compositor
import ui/geometry
import ui/window
import ui/vector
import ui/pixel
import ui/rect
import drivers

import utils
import map

val CASCADE = 48.0

record Managed(
  window: Window,
  accent: Color,
  position: Vector,
  size: Vector,
  frame: Context,
  contexts: List[Context]
)

type Grab {
  NoGrab();
  Grabbing(window: WindowId, inside: Vector)
}

def manager { windows: => Nothing / { WindowManager, Input } }: Nothing / Compositor = {
  with on[MissingValue].panic()

  var counter = 0

  val screen = do resolution()

  val managed = map::empty[WindowId, Managed](box compareInt).ref
  val pointer = ((screen - cursor::size) / 2.0).ref
  val grabbed = NoGrab().ref
  val cascading = Vector(CASCADE, CASCADE).ref
  val focused: Ref[Option[WindowId]] = None().ref

  def lookup(id: WindowId): Option[Managed] = managed.get.get(id)
  def store(m: Managed): Unit = managed.map { ms => ms.put(m.window.id, m) }

  def focused?(window: WindowId): Bool =
    with on[MissingValue].default { false }
    focused.get.value == window

  def raise(m: Managed): Unit = {
    focused.set(Some(m.window.id))
    do focus(Cons(m.frame, m.contexts).map { c => c.id })
  }

  def frame(at: Vector, size: Vector, accent: Color): Context = {
    val context = do freshContext(at, size)
    frame(context.geometry, accent)
    do markDirty(context.id)
    context
  }

  def cascade(size: Vector): Vector = {
    val limit = Vector(max(0.0, screen.x - size.x), max(0.0, screen.y - size.y))
    val candidate = cascading.get
    val at = if (candidate.x > limit.x || candidate.y > limit.y) Vector(CASCADE, CASCADE) else candidate
    cascading.set(at + CASCADE)
    clamp(at, limit)
  }

  def topmostAt(position: Vector): Option[Window] = {
    def hit?(m: Managed) = Rect(m.position, m.size).contains?(position)

    val top = focused.get match {
      case Some(id) => lookup(id).filter {hit?}
      case None() => None()
    }
    // TODO: leak fewer implementation details (map ordering)
    top.orElse { managed.get.findReversed {hit?} }.map { m => m.window }
  }

  def move(m: Managed, to: Vector): Unit = {
    val by = to - m.position
    if (to == m.position) ()
    else {
      m.contexts.foreach { c => do compositor::move(c.id, by) }
      do compositor::move(m.frame.id, by)
      store(Managed(m.window, m.accent, to, m.size, m.frame, m.contexts))
    }
  }

  def drag(): Unit = grabbed.get match {
    case NoGrab() => ()
    case Grabbing(id, inside) => lookup(id) match {
      case None() => grabbed.set(NoGrab())
      case Some(m) => m.move(clamp(pointer.get - inside, screen - m.size))
    }
  }

  def press(): Unit = grabbed.get match {
    case Grabbing(_, _) => () // already dragging
    case NoGrab() =>
      with val window = topmostAt(pointer.get).foreach
      with val m = lookup(window.id).foreach
      grabbed.set(Grabbing(window.id, pointer.get - m.position))
      if (not(focused?(window.id))) raise(m)
  }

  try windows()
  with WindowManager {
    def create(size, accent) = {
      counter = counter + 1
      val window = Window(counter)
      val at = cascade(size)
      val m = Managed(window, accent, at, size, frame(at, size, accent), [])
      m.store()
      m.raise()
      resume(window)
    }

    def size(window) = resume { lookup(window.id).value.size }

    def resize(window, size) = resume {
      val m = lookup(window.id).value
      val frame = do freshContext(m.position, size)
      window::frame(frame.geometry, m.accent)
      do markDirty(frame.id)
      do compositor::destroy(m.frame.id)
      managed.map { ms =>
        ms.put(m.window.id, Managed(m.window, m.accent, m.position, size, frame, m.contexts))
      }
    }

    def context(window, position, size) = resume {
      val m = lookup(window.id).value
      val context = do freshContext(m.position + position, size)
      val updated = Managed(m.window, m.accent, m.position, m.size, m.frame, m.contexts.append([context]))
      updated.store()
      if (window.id.focused?) updated.raise() // keep all focused
      context
    }

    def dirty(window, context) = resume {
      val m = lookup(window.id).value
      if (not(m.contexts.contains(context) { (a, b) => a.id == b.id }))
        missingValue()
      do markDirty(context.id)
    }

    def destroy(window) = resume {
      val m = lookup(window.id).value
      m.contexts.foreach { c => do compositor::destroy(c.id) }
      do compositor::destroy(m.frame.id)
      managed.map { ms => ms.map::delete(window.id) }
      if (window.id.focused?) focused.set(None())
      grabbed.get match {
        case NoGrab() => ()
        case Grabbing(id, _) => if (id == window.id) grabbed.set(NoGrab())
      }
    }

    def at(position) = resume { topmostAt(position).value }
  }
  with keyboard {
    case Press(ch) => resume(())
  }
  with mouse {
    case Click(left, middle, right) => {
      if (left) press() else grabbed.set(NoGrab())
      resume(())
    }
    case Move(x, y) => {
      pointer.set(clamp(pointer.get + Vector(x, 0.0 - y), screen - cursor::size))
      do cursor(pointer.get)
      drag()
      resume(())
    }
  }
  with tick { resume(do compositor::redrawDirty()) }
}
