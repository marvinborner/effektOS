import windows/compositor
import system/process
import ui/compositor
import ui/geometry
import ui/truetype
import ui/window
import ui/vector
import ui/pixel
import ui/rect
import drivers

import utils
import map

val CASCADE = 48.0

record Managed(
  window: Window,
  owner: Process,
  group: GroupId,
  position: Vector,
  size: Vector,
  title: String,
  accent: Color,
  frame: Context,
  contexts: List[Context]
)

type Action {
  NoAction();
  Moving(window: WindowId, relative: Vector)
  Resizing(window: WindowId)
}

def manager(?font: Font) { inputs: => Nothing / Input } { apps: { => Nothing / Apps } => Nothing / WindowManager }: Nothing / Compositor = {
  with on[MissingValue].panic()

  var counter = 0

  val screen = do resolution()

  val managed = map::empty[WindowId, Managed](box compareInt).ref
  val stack: Ref[List[WindowId]] = Nil().ref // top to bottom
  val pointer = ((screen - cursor::size) / 2.0).ref
  val action = NoAction().ref
  val cascading = Vector(CASCADE, CASCADE).ref

  def lookup(id: WindowId): Option[Managed] = managed.get.get(id)
  def store(m: Managed): Unit = managed.map { ms => ms.put(m.window.id, m) }

  def focused?(window: WindowId): Bool = stack.get.headOption match {
    case Some(top) => top == window
    case None() => false
  }

  def raise(m: Managed): Unit = {
    stack.map { s => Cons(m.window.id, s.filter { w => w != m.window.id }) }
    do focus(m.group)
  }

  def frame(group: GroupId, at: Vector, size: Vector, title: String, accent: Color): Context = {
    val context = do createContext(group, at, size)
    window::frame(context.geometry, title, accent)
    do markDirty(context.id)
    context
  }

  def cascade(size: Vector): Vector = {
    val limit = Vector(max(0.0, screen.x - size.x), max(0.0, screen.y - size.y))
    val candidate = cascading.get
    val at = if (candidate.x > limit.x || candidate.y > limit.y) Vector(CASCADE, CASCADE) else candidate
    cascading.set(at + CASCADE)
    clamp(at, limit)
  }

  def topmostAt(position: Vector): Option[Window] = {
    def hit?(m: Managed) = Rect(m.position, m.size).contains?(position)
    def go(windows: List[WindowId]): Option[Window] = windows match {
      case Nil() => None()
      case Cons(w, below) => lookup(w).filter {hit?} match {
        case Some(m) => Some(m.window)
        case None() => go(below)
      }
    }
    go(stack.get)
  }

  def move(m: Managed, to: Vector): Unit = {
    val by = to - m.position
    if (to == m.position) ()
    else {
      m.contexts.foreach { c => do compositor::move(c.id, by) }
      do compositor::move(m.frame.id, by)
      store(Managed(m.window, m.owner, m.group, to, m.size, m.title, m.accent, m.frame, m.contexts))
    }
  }

  // TODO: clip underlying contexts
  def resize(m: Managed, _size: Vector): Vector = {
    val size = max(_size, Vector(50.0, 50.0))
    if (size == m.size) size else {
      val frame = do compositor::resize(m.frame.id, size)
      window::frame(frame.geometry, m.title, m.accent)
      store(Managed(m.window, m.owner, m.group, m.position, size, m.title, m.accent, frame, m.contexts))
      size
    }
  }

  def drag(): Unit / Apps = action.get match {
    case NoAction() => ()
    case Moving(id, relative) => lookup(id) match {
      case None() => action.set(NoAction())
      case Some(m) => m.move(clamp(pointer.get - relative, screen - m.size))
    }
    case Resizing(id) => lookup(id) match {
      case None() => action.set(NoAction())
      case Some(m) => {
        val resized = m.resize(pointer.get - m.position)
        if (not(resized == m.size)) do send(m.owner, Resize(resized))
      }
    }
  }

  def leftClick(): Unit / Apps = action.get match {
    case Moving(_, _) => () // already moving
    case Resizing(_) => () // currently resizing
    case NoAction() =>
      with val window = topmostAt(pointer.get).foreach
      with val m = lookup(window.id).foreach
      if (not(focused?(window.id))) raise(m)
      val relative = pointer.get - m.position
      if (relative.y < TITLEBAR) {
        if (m.size.closeButton.contains?(relative))
          do send(m.owner, Exit())
        else
          action.set(Moving(window.id, relative))
      }
      else do send(m.owner, Click(relative))
  }

  def rightClick(): Unit / Apps = action.get match {
    case Resizing(_) => () // already resizing
    case Moving(_, _) => () // currently moving
    case NoAction() =>
      with val window = topmostAt(pointer.get).foreach
      with val m = lookup(window.id).foreach
      action.set(Resizing(window.id))
      if (not(focused?(window.id))) raise(m)
  }

  def keypress(ch: Char): Unit / Apps = {
    with val window = topmostAt(pointer.get).foreach
    with val m = lookup(window.id).foreach
    do send(m.owner, Keypress(ch))
  }

  def handlers(): Nothing / Apps = {
    try inputs()
    with keyboard {
      case KeyboardEvent::Press(ch) => resume(keypress(ch))
    }

    with mouse {
      case MouseEvent::Click(left, middle, right) => {
        if (left) leftClick()
        else if (right) rightClick()
        else action.set(NoAction())
        resume(())
      }
      case MouseEvent::Move(x, y) => {
        pointer.set(clamp(pointer.get + Vector(x, 0.0 - y), screen - cursor::size))
        do cursor(pointer.get)
        resume(())
      }
    }

    with tick {
      drag()
      do sendAll(Tick())
      resume(do compositor::redrawDirty())
    }
  }

  try apps {handlers}
  with WindowManager {
    def create(owner, size, title, accent) = {
      counter = counter + 1
      val window = Window(counter)
      val group = do createGroup()
      val at = cascade(size)
      val frame = frame(group, at, size, title, accent)
      val m = Managed(window, owner, group, at, size, title, accent, frame, [])
      m.store()
      m.raise()
      resume(window)
    }

    def size(window) = resume { lookup(window.id).value.size }

    def resize(window, size) = resume {
      val m = lookup(window.id).value
      val resized = m.resize(size)
      ()
    }

    def context(window, position, size) = resume {
      val m = lookup(window.id).value
      val context = do createContext(m.group, m.position + position, size)
      store(Managed(m.window, m.owner, m.group, m.position, m.size, m.title, m.accent, m.frame, m.contexts.append([context])))
      context
    }

    def dirty(window, context) = resume {
      val m = lookup(window.id).value
      if (not(m.contexts.contains(context) { (a, b) => a.id == b.id }))
        missingValue()
      do markDirty(context.id)
    }

    def destroy(window) = resume {
      val m = lookup(window.id).value
      do destroyGroup(m.group)
      managed.map { ms => ms.map::delete(window.id) }
      stack.map { s => s.filter { w => w != window.id } }
      action.get match {
        case NoAction() => ()
        case Moving(id, _) => if (id == window.id) action.set(NoAction())
        case Resizing(id) => if (id == window.id) action.set(NoAction())
      }
    }

    def remove(window, context) = resume {
      val m = lookup(window.id).value
      val updated = m.contexts.filter { c => c.id != context.id }
      if (updated.size == m.contexts.size) // TODO
        missingValue()
      do destroyContext(context.id)
      store(Managed(m.window, m.owner, m.group, m.position, m.size, m.title, m.accent, m.frame, updated))
    }

    def at(position) = resume { topmostAt(position).value }

    def query(title) = resume(managed.get.values.filter { m => m.title == title }.map { m => m.owner })
  }
}
