interface State[St] {
  def getState(): St
  def setState(s: St): Unit
}

def statefully[St](r: Ref[St]) { prog: => Nothing / State[St] }: Nothing =
  try prog()
  with State[St] {
    def getState() = resume(r.get())
    def setState(newState) = { r.set(newState); resume(()) }
  }

// --- driver states

record PS2MouseBytes(clicked: Byte, x: Byte, y: Byte, scroll: Byte)

type MouseState {
  NoMouseState();
  PS2MouseState(cycle: Int, bytes: PS2MouseBytes);
}

type KeyboardState {
  NoKeyboardState();
  PS2KeyboardState(shift: Bool);
}

// --- input events

type KeyboardEvent { Press(ch: Char) }
type MouseEvent { Move(x: Byte, y: Byte); Click(left: Bool, middle: Bool, right: Bool) }

effect keyboard(ev: KeyboardEvent): Unit
effect mouse(ev: MouseEvent): Unit
effect Input = { keyboard, mouse }

// --- output events

effect Output = { emit[Char] }
