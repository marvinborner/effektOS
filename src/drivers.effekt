interface State[St] {
  def getState(): St
  def setState(s: St): Unit
}

def state[St](r: Ref[St]) { prog: => Nothing / State[St] }: Nothing =
  try prog()
  with State[St] {
    def getState() = resume(r.get())
    def setState(newState) = { r.set(newState); resume(()) }
  }

// --- driver states ---

record PS2MouseBytes(clicked: Byte, x: Byte, y: Byte, scroll: Byte)

type MouseState {
  NoMouseState();
  PS2MouseState(cycle: Int, bytes: PS2MouseBytes);
}

type KeyboardState {
  NoKeyboardState();
  PS2KeyboardState(shift: Bool);
}

type TimerState {
  NoTimerState();
  PITimerState(ticks: Int);
}

type FramebufferState {
  NoFramebufferState();
  BGAFramebufferState(pitch: Int, depth: Int, width: Int, height: Int, fb: C::Ptr)
}

effect Global = { State[KeyboardState], State[MouseState], State[TimerState], State[FramebufferState] }

// --- input events ---

type KeyboardEvent { Press(ch: Char) }
type MouseEvent { Move(x: Byte, y: Byte); Click(left: Bool, middle: Bool, right: Bool) }

effect keyboard(ev: KeyboardEvent): Unit
effect mouse(ev: MouseEvent): Unit
effect tick(): Unit
effect Input = { keyboard, mouse, tick }

// --- output events ---

type FramebufferEvent { Redraw(buffer: ByteArray) }

record GraphicsContext(pitch: Int, height: Int, buffer: ByteArray)

effect framebuffer(ev: FramebufferEvent): Unit
effect Output = { framebuffer }
