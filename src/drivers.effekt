interface State[St] {
  def getState(): St
  def setState(s: St): Unit
}

def statefully[St](r: Ref[St]) { prog: => Nothing / State[St] }: Nothing =
  try prog()
  with State[St] {
    def getState() = resume(r.get())
    def setState(newState) = { r.set(newState); resume(()) }
  }

// ---

type KeyboardEvent { Press(ch: Char) }
type MouseEvent { Move(x: Byte, y: Byte); Click(left: Bool, middle: Bool, right: Bool) }

interface Input {
  def keyboard(ev: KeyboardEvent): Unit
  def mouse(ev: MouseEvent): Unit
}

// ---

effect Output = { emit[Char] }
