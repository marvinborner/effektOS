import scanner

import utils
import drivers

type Expr {
  Num(value: Int)
  Add(left: Expr, right: Expr)
  Sub(left: Expr, right: Expr)
  Mul(left: Expr, right: Expr)
}

def handle { drivers: => Nothing / Input } { prog: => Unit / next[Char] }: Unit =
  with source[Char] {
    try drivers()
    with keyboard {
      case Press(ch) => resume(do emit(ch))
    }
    with mouse {
      case Click(left, middle, right) =>
        resume(println(s"[${left.show},${middle.show},${right.show}]\n"))
      case Move(x, y) =>
        resume(println(s"[${x.toInt.show},${y.toInt.show}]\n"))
    }
    with tick { resume(()) }
  }
  prog()

def program() { drivers: => Nothing / Input }: Unit / Output = {
  with handle{drivers}

  "Welcome to the Effekt Kalkulator! Please give me your expressions :)\n".each

  with loop
  with onFail { "\ninvalid input\n".each }
  with interruptible
  with scanning[Char, Unit]

  val a = readDecimal()
  skipWhitespace()
  val op = do next()
  skipWhitespace()
  val b = readDecimal()
  s"= ${(a - b).show}\n".each
  skipWhitespace()
}
