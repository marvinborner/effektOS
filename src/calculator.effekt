import utils
import framebuffer

import scanner

type Expr {
  Num(value: Int)
  Add(left: Expr, right: Expr)
  Sub(left: Expr, right: Expr)
  Mul(left: Expr, right: Expr)
}

def program(): Unit / { read[Char], emit[Char] } = {
  "Welcome to the Effekt Kalkulator! Please give me your expressions :)\n".each

  with loop
  with onFail { "\ninvalid input".each }
  with interruptible
  with scanning[Char, Unit]

  val a = readDecimal()
  skipWhitespace()
  val op = do read()
  skipWhitespace()
  val b = readDecimal()
  s" = ${(a - b).show}\n".each
  skipWhitespace()
}
