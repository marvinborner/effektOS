import scanner

import utils
import framebuffer
import drivers

type Expr {
  Num(value: Int)
  Add(left: Expr, right: Expr)
  Sub(left: Expr, right: Expr)
  Mul(left: Expr, right: Expr)
}

def program() { drivers: => Unit / Input }: Unit / Output = {
  // with mouseReader{drivers}
  with keyboardReader{drivers}

  "Welcome to the Effekt Kalkulator! Please give me your expressions :)\n".each

  with loop
  with onFail { "\ninvalid input\n".each }
  with interruptible
  with scanning[Char, Unit]

  val a = readDecimal()
  skipWhitespace()
  val op = do read()
  skipWhitespace()
  val b = readDecimal()
  s"= ${(a - b).show}\n".each
  skipWhitespace()
}
