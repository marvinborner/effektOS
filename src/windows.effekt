import io/error

import windows/manager
import windows/compositor
import processes/scheduler
import drivers

import ui/window
import ui/truetype
import system/calls

import apps/team
import apps/ipc
// import apps/kalkulator

def start { inputs: => Nothing / Input }: Nothing / { Output, System } = {
  with on[WrongFormat].panic
  with on[IOError].panic
  val font = load("/res/fonts/DejaVuSans.ttf")

  with compositor
  with def handlers = manager {inputs}
  processes([
    ipc::app(),
    ipc::app(),
    ipc::app(),
    ipc::app(),
    team::app()
  ], box from) { app => (app.start)() } {handlers}
}
