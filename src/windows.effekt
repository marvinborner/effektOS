import windows/compositor
import windows/manager
import drivers

import ui/window
import system/calls
import apps/team
// import apps/kalkulator

def apps(): Unit / { System, WindowManager } = {
  team::start()
  team::start()
}

def start { inputs: => Nothing / Input }: Nothing / { Output, System } = {
  with compositor
  with manager

  apps()
  inputs()
}
