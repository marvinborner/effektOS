import io/error

import windows/compositor
import windows/manager
import drivers

import ui/window
import ui/truetype
import system/calls

import apps/team
// import apps/kalkulator

def apps(): Unit / { System, WindowManager } = {
  team::start()
  team::start()
}

def start { inputs: => Nothing / Input }: Nothing / { Output, System } = {
  with on[WrongFormat].panic
  with on[IOError].panic
  val font = load("/res/fonts/DejaVuSans.ttf")

  with compositor
  with manager

  apps()
  inputs()
}
