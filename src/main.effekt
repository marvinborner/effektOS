import x86/pic
import x86/serial
import x86/commands
import x86/interrupts
import interrupt

import panic

import capabilities/timer
import capabilities/graphics
import capabilities/keyboard
import capabilities/mouse
import drivers
import system

import windows
import utils

def fault(fault: Fault) = {
  panic(s"""
=============
=== FAULT ===
=============

${fault.pretty}
""")
}

def output { outputs: => Nothing / Output }: Nothing / Global =
  with graphics::handler
  outputs()

def os { inputs: => Nothing / Input }: Nothing / { Output, Global } =
  with system // hides global state!
  windows::start() { inputs }

def input { requests: => Nothing / Request }: Nothing / { Input, Global } = {
  with interrupt::handler[TimerTick, TimerState] { timer::handler }
  with interrupt::handler[PS2Keyboard, KeyboardState] { keyboard::handler }
  with interrupt::ignored[Cascade]
  with interrupt::ignored[COM2]
  with interrupt::ignored[COM1]
  with interrupt::ignored[LPT2]
  with interrupt::ignored[FloppyDisk]
  with interrupt::ignored[LPT1]
  with interrupt::ignored[CMOS]
  with interrupt::ignored[Peripheral1]
  with interrupt::ignored[Peripheral2]
  with interrupt::ignored[Peripheral3]
  with interrupt::handler[PS2Mouse, MouseState] { mouse::handler }
  with interrupt::ignored[FPU]
  with interrupt::ignored[PrimaryATA]
  with interrupt::ignored[SecondaryATA]
  with dispatch
  requests()
}

def loop(): Nothing = {
  serial::init()

  with state[KeyboardState](empty().ref)
  with state[MouseState](empty().ref)
  with state[TimerState](empty().ref)
  with state[FramebufferState](empty().ref)

  // interrupts
  val inbox = interrupts::init(box fault)
  pic::init()

  // capabilities
  timer::init(100)
  keyboard::init()
  mouse::init()
  graphics::init()

  with output
  with os
  with input
  interrupts::idle(inbox)
}

def main() = {
  loop()
  panic("loop returned?!")
  ()
}
