import x86/pic
import x86/serial
import x86/commands
import x86/interrupts
import interrupt

import panic

import drivers
import capabilities/timer
import capabilities/graphics
import capabilities/keyboard
import capabilities/mouse

import graphics/framebuffer

import calculator
import utils

import scanner

def header(): Unit / Output = {
  val logo = """
  _____     ______  __  __     _    _    ____   _____
 (_____)   |  ____|/ _|/ _|   | |  | |  / __ \ / ____|
   ___     | |__  | |_| |_ ___| | _| |_| |  | | (___
  (___)    |  __| |  _|  _/ _ \ |/ / __| |  | |\___ \
  _____    | |____| | | ||  __/   <| |_| |__| |____) |
 (_____)   |______|_| |_| \___|_|\_\\__|\____/|_____/
"""
  logo.each
}

def fault(fault: Fault) = {
  panic(s"""
=============
=== FAULT ===
=============

${fault.pretty}
""")
}

def output { outputs: => Nothing / Output }: Nothing / Global = {
  with emit[Char, Nothing] { ch => () }
  with graphics::handler
  outputs()
}

def os { inputs: => Nothing / Input }: Nothing / { Output, Global } = {
  with looping

  calculator::program() {inputs}
}

def input { requests: => Nothing / Request }: Nothing / { Input, Global } = {
  with interrupt::handler[TimerTick, TimerState] { timer::handler }
  with interrupt::handler[PS2Keyboard, KeyboardState] { keyboard::handler }
  with interrupt::on[Cascade].ignore
  with interrupt::on[COM2].ignore
  with interrupt::on[COM1].ignore
  with interrupt::on[LPT2].ignore
  with interrupt::on[FloppyDisk].ignore
  with interrupt::on[LPT1].ignore
  with interrupt::on[CMOS].ignore
  with interrupt::on[Peripheral1].ignore
  with interrupt::on[Peripheral2].ignore
  with interrupt::on[Peripheral3].ignore
  with interrupt::handler[PS2Mouse, MouseState] { mouse::handler }
  with interrupt::on[FPU].ignore
  with interrupt::on[PrimaryATA].ignore
  with interrupt::on[SecondaryATA].ignore
  with dispatch
  requests()
}

def loop(): Nothing = {
  serial::init()

  with state[KeyboardState](empty().ref)
  with state[MouseState](empty().ref)
  with state[TimerState](empty().ref)
  with state[FramebufferState](empty().ref)

  // interrupts
  val inbox = interrupts::init(box fault)
  pic::init()

  // capabilities
  timer::init()
  keyboard::init()
  mouse::init()
  graphics::init()

  with output
  with os
  with input
  interrupts::idle(inbox)
}

def main() = {
  loop()
  panic("loop returned?!")
  ()
}
