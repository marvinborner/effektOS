import drivers
import x86/commands

def init(hz: Int) = {
  do setState(PITimerState(0))

  val divisor = 3579545 / 3 / hz
  outb(0x43, 0x36) // CTR, RW, MODE, BCD
  outb(0x40, divisor.bitwiseAnd(255).toByte)
  outb(0x40, divisor.bitwiseShr(8).toByte)
}

def handler(): Unit / { State[TimerState], tick } = {
  val PITimerState(ticks) = do getState()
    else panic("invalid timer state")
  do setState(PITimerState(ticks + 1))
  do tick()
}
