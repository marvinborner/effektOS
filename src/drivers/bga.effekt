module framebuffer/bga

import bits
import drivers
import drivers/pci
import x86/commands

val ADDRESS = 462
val DATA = 463

val VERSION = 0
val XRES = 1
val YRES = 2
val BPP = 3
val ENABLE = 4
val BANK = 5
val VWIDTH = 6
val VHEIGHT = 7
val XOFF = 8
val YOFF = 9

val LINEAR_FB = 0x40.toInt

def writeRegister(address: Short, data: Short) = {
  outw(ADDRESS, address)
  outw(DATA, data)
}

def readRegister(address: Short) = {
  outw(ADDRESS, address)
  return inw(DATA)
}

extern def toPtr(address: Int) at {}: C::Ptr =
  llvm "%p = inttoptr %Int ${address} to ptr ret ptr %p"

val VENDOR = 4660 // 0x1234, QEMU/Bochs
val DEVICE = 4369 // 0x1111

def discover(): Option[C::Ptr] =
  pci::find(VENDOR, DEVICE) match {
    case None() => None()
    case Some(dev) => Some(dev.bar(0).toPtr)
  }

extern def apply(fb: C::Ptr, buffer: ByteArray, n: Int) at global: Unit =
  llvm """
    %buffer_ptr = extractvalue %Pos ${buffer}, 1
    %buffer_data_ptr = getelementptr inbounds i8, ptr %buffer_ptr, i64 16
    call void @memcpy(ptr ${fb}, ptr %buffer_data_ptr, i64 ${n})
    ret %Pos zeroinitializer
  """

def enable(fb: C::Ptr, width: Short, height: Short, depth: Short) = {
  writeRegister(ENABLE, 0)
  writeRegister(XRES, width)
  writeRegister(YRES, height)
  writeRegister(BPP, depth)
  writeRegister(ENABLE, 1.bitwiseOr(LINEAR_FB))

  val pitch = width * depth.bitwiseShr(3)
  do setState(BGAFramebufferState(pitch, depth, width, height, fb))
}

def init() =
  discover() match {
    case None() => panic("no BGA adapter on the PCI bus")
    case Some(fb) => enable(fb, 1920, 1200, 32)
  }

def handler { prog: => Nothing / framebuffer }: Nothing / State[FramebufferState] = {
  val BGAFramebufferState(pitch, depth, width, height, fb) = do getState()
    else panic("invalid framebuffer state")

  try prog()
  with framebuffer {
    case Redraw(buffer) =>
      fb.apply(buffer, min(height * pitch, buffer.size))
      resume(())
  }
}

def context() = {
  val BGAFramebufferState(pitch, depth, width, height, fb) = do getState[FramebufferState]()
    else panic("invalid state")
  val buffer = bytearray::allocate(height * pitch)
  GraphicsContext(pitch, height, buffer)
}
