module ps2/mouse

import bits
import panic
import x86/commands

import drivers
import drivers/ps2

def empty() = PS2MouseBytes(0x00, 0x00, 0x00, 0x00)

def init() = {
  do setState(PS2MouseState(0, empty()))

  // disable PS2
  command(0xAD)
  command(0xA7)

  flush()

  var conf = config()
  conf = PS2Config(conf.bits.unset!(0).unset!(1)) // disable IRQs
  config(conf)

  // test controller
  command(0xAA)
  assert(readData() == 0x55, "controller failed")
  config(conf)

  // test first port
  command(0xAB)
  assert(readData() == 0x00, "first port failed")
  command(0xAE) // enable
  conf = PS2Config(conf.bits.unset!(4))

  // test second port
  assert(conf.bits.set?(5), "second port not available")
  command(0xA9)
  assert(readData() == 0x00, "second port failed")
  command(0xA8) // enable
  conf = PS2Config(conf.bits.unset!(5))

  // write config (IRQs still masked)
  config(conf)

  val keyboard = PS2Device(0x00)
  assert(keyboard.kind.keyboard?, "device 0 is not a keyboard")
  assert(keyboard.reset, "keyboard reset failed")
  assert(keyboard.write(0xF4), "keyboard scanning failed")

  val mouse = PS2Device(0x01)
  assert(ignoreTimeout { mouse.kind.mouse? }, "device 1 is not a mouse")
  assert(mouse.reset, "mouse reset failed")

  assert(mouse.write(0xF6), "default settings failed")
  assert(mouse.write(0xF3), "mouse rate failed 1")
  assert(mouse.write(0x14), "mouse rate failed 2") // 20
  assert(mouse.write(0xF4), "enable failed")

  flush()

  // enable IRQs
  conf = PS2Config(conf.bits.set!(0).set!(1))
  config(conf)
}

def signed(byte: Byte): Double = {
  val value = byte.toInt
  if (value > 127) (value - 256).toDouble else value.toDouble
}

def handler(): Unit / { State[MouseState], mouse } = {
  def step(byte: Byte): Unit = {
    val PS2MouseState(cycle, bytes) = do getState()
      else panic("invalid mouse state")
    cycle match {
      case 0 =>
        // (bit 3 should always be set)
        if (byte.set?(3))
          do setState(PS2MouseState(1, PS2MouseBytes(byte, 0x00, 0x00, 0x00)))
      case 1 =>
        do setState(PS2MouseState(2, PS2MouseBytes(bytes.clicked, byte, 0x00, 0x00)))
      case _ => {
        do setState(PS2MouseState(0, empty()))
        do mouse(Move(bytes.x.signed, byte.signed))
        do mouse(Click(
          bytes.clicked.set?(0), // left
          bytes.clicked.set?(2), // middle
          bytes.clicked.set?(1)  // right
        ))
      }
    }
  }

  // reads only mouse's packets, not keyboard's
  def exhaustively(): Unit = {
    val s = status()
    if (s.out? && s.aux?) {
      step(inb(PORT))
      exhaustively()
    }
  }

  exhaustively()
}
