import drivers
import drivers/ps2
import drivers/ps2/mouse

def empty() = NoMouseState()

def init() = {
  // TODO: only if PS/2 mouse is connected
  noTimeout { ps2::mouse::init() }
}

def handler(): Unit / { State[MouseState], Input } = {
  // TODO: only if PS/2 mouse is connected
  ps2::mouse::handler()
}
