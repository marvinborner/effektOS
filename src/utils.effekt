import scanner

def looping { prog: => Unit }: Nothing = {
  def go(): Nothing = {
    prog()
    go()
  }
  go()
}

def nothing { prog: => Unit }: Nothing = {
  prog()
  <>
}

extern def equal?(x: Double, y: Double) at {}: Bool =
  js "(${x} === ${y})"
  chez "(= ${x} ${y})"
  llvm """
    %z = fcmp oeq %Double ${x}, ${y}
    %fat_z = zext i1 %z to i64
    %adt_boolean = insertvalue %Pos zeroinitializer, i64 %fat_z, 0
    ret %Pos %adt_boolean
  """

def emit[A, R] { f: A => Unit } { prog: => R / emit[A] }: R = {
  try prog()
  with emit[A] { v => resume(f(v)) }
}

def interruptible { prog: => Unit / emit[Char] }: Unit / { emit[Char], stop } = {
  for[Char] { prog } { ch =>
    if (ch == '\u1b') do stop()
    else do emit(ch)
  }
}

def scanning[A, R] { scanner: () => R / Scan[A] }: R / { next[A], emit[A] } = {
  def upstream(): A / stop = {
    val a = do next()
    do emit(a)
    a
  }
  var last = None()
  try {
    scanner()
  } with peek[A] { () =>
    resume {
      last match {
        case None() =>
          val t = upstream()
          last = Some(t)
          return t
        case Some(t) =>
          return t
      }
    }
  } with next[A] {
    resume {
      last match {
        case None() =>
          upstream()
        case Some(t) =>
          last = None()
          return t
      }
    }
  }
}

extern def get64(buffer: ByteArray, index: Int) at global: Int =
  llvm """
    %last = add i64 ${index}, 3
    call void @assertInboundsByteArray(i64 %last, %Pos ${buffer})
    %base = extractvalue %Pos ${buffer}, 1
    %data = getelementptr inbounds i8, ptr %base, i64 16
    %slot = getelementptr inbounds i8, ptr %data, i64 ${index}
    %word = load i32, ptr %slot, align 1
    %z = zext i32 %word to i64
    tail call void @erasePositive(%Pos ${buffer})
    ret %Int %z
  """

extern def set64(buffer: ByteArray, index: Int, value: Int) at global: Unit =
  llvm """
    %last = add i64 ${index}, 3
    call void @assertInboundsByteArray(i64 %last, %Pos ${buffer})
    %base = extractvalue %Pos ${buffer}, 1
    %data = getelementptr inbounds i8, ptr %base, i64 16
    %slot = getelementptr inbounds i8, ptr %data, i64 ${index}
    %word = trunc %Int ${value} to i32
    store i32 %word, ptr %slot, align 1
    tail call void @erasePositive(%Pos ${buffer})
    ret %Pos zeroinitializer
  """
