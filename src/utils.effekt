// random stuff, potentially to be added to Effekt's standard library

import scanner

def looping { prog: => Unit }: Nothing = {
  def go(): Nothing = {
    prog()
    go()
  }
  go()
}

def nothing { prog: => Unit }: Nothing = {
  prog()
  <>
}

extern def equal?(x: Double, y: Double) at {}: Bool =
  js "(${x} === ${y})"
  chez "(= ${x} ${y})"
  llvm """
    %z = fcmp oeq %Double ${x}, ${y}
    %fat_z = zext i1 %z to i64
    %adt_boolean = insertvalue %Pos zeroinitializer, i64 %fat_z, 0
    ret %Pos %adt_boolean
  """

def emit[A, R] { f: A => Unit } { prog: => R / emit[A] }: R = {
  try prog()
  with emit[A] { v => resume(f(v)) }
}

def interruptible { prog: => Unit / emit[Char] }: Unit / { emit[Char], stop } = {
  for[Char] { prog } { ch =>
    if (ch == '\u1b') do stop()
    else do emit(ch)
  }
}

def scanning[A, R] { scanner: () => R / Scan[A] }: R / { next[A], emit[A] } = {
  def upstream(): A / stop = {
    val a = do next()
    do emit(a)
    a
  }
  var last = None()
  try {
    scanner()
  } with peek[A] { () =>
    resume {
      last match {
        case None() =>
          val t = upstream()
          last = Some(t)
          return t
        case Some(t) =>
          return t
      }
    }
  } with next[A] {
    resume {
      last match {
        case None() =>
          upstream()
        case Some(t) =>
          last = None()
          return t
      }
    }
  }
}

namespace bytes {
  def get8(data: ByteArray, at: Int): Int = data.get(at).toInt
  def get16(data: ByteArray, at: Int): Int = data.get8(at).bitwiseOr(data.get8(at + 1).bitwiseShl(8))
  def get32(data: ByteArray, at: Int): Int = data.get16(at).bitwiseOr(data.get16(at + 2).bitwiseShl(16))

  extern def get64(data: ByteArray, at: Int) at global: Int =
    llvm """
      %last = add i64 ${at}, 3
      call void @assertInboundsByteArray(i64 %last, %Pos ${data})
      %base = extractvalue %Pos ${data}, 1
      %data = getelementptr inbounds i8, ptr %base, i64 16
      %slot = getelementptr inbounds i8, ptr %data, i64 ${at}
      %word = load i32, ptr %slot, align 1
      %z = zext i32 %word to i64
      tail call void @erasePositive(%Pos ${data})
      ret %Int %z
    """

  extern def set64(data: ByteArray, at: Int, value: Int) at global: Unit =
    llvm """
      %last = add i64 ${at}, 3
      call void @assertInboundsByteArray(i64 %last, %Pos ${data})
      %base = extractvalue %Pos ${data}, 1
      %data = getelementptr inbounds i8, ptr %base, i64 16
      %slot = getelementptr inbounds i8, ptr %data, i64 ${at}
      %word = trunc %Int ${value} to i32
      store i32 %word, ptr %slot, align 1
      tail call void @erasePositive(%Pos ${data})
      ret %Pos zeroinitializer
    """
}
