extern llvm """
  declare void @hcf()
  declare void @segfault()
"""

extern def hcf() at io: Nothing =
  llvm """
    call void @hcf()
    ret %Pos zeroinitializer
  """

extern def segfault() at io: Unit =
  llvm """
    call void @segfault()
    ret %Pos zeroinitializer
  """

def assert(x: Bool) =
  if (x) ()
  else panic("\n!!!\nassertion failed!\n!!!\n")

def assert(x: Bool, msg: String) =
  if (x) ()
  else panic(s"\n!!!\nassertion failed: ${msg}!\n!!!\n")
