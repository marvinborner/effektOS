import bits

extern def halt() at io: Unit =
  llvm """
    call void asm sideeffect "hlt", "~{memory},~{dirflag},~{fpsr},~{flags}"()
    ret %Pos zeroinitializer
  """

extern def cli() at io: Unit =
  llvm """
    call void asm sideeffect "cli", "~{memory},~{dirflag},~{fpsr},~{flags}"()
    ret %Pos zeroinitializer
  """

extern def sti() at io: Unit =
  llvm """
    call void asm sideeffect "sti", "~{memory},~{dirflag},~{fpsr},~{flags}"()
    ret %Pos zeroinitializer
  """

def atomically[R] { prog: => R } = {
  cli()
  prog()
  sti()
}

extern def outb(port: Short, data: Byte) at io: Unit =
  llvm """
    %port16 = trunc i64 ${port} to i16
    call void asm sideeffect "outb $1, $0", "{dx}N,{ax},~{flags}"(i16 %port16, i8 ${data})
    ret %Pos zeroinitializer
  """

extern def outw(port: Short, data: Short) at io: Unit =
  llvm """
    %port16 = trunc i64 ${port} to i16
    %data16 = trunc i64 ${data} to i16
    call void asm sideeffect "outw $1, $0", "{dx}N,{ax},~{flags}"(i16 %port16, i16 %data16)
    ret %Pos zeroinitializer
  """

extern def inb(port: Short) at io: Byte =
  llvm """
    %port16 = trunc i64 ${port} to i16
    %res = call i8 asm sideeffect "inb $1, $0", "={ax},{dx}N,~{flags}"(i16 %port16)
    ret i8 %res
  """

extern def inw(port: Short) at io: Short =
  llvm """
    %port16 = trunc i64 ${port} to i16
    %res = call i16 asm sideeffect "inw $1, $0", "={ax},{dx}N,~{flags}"(i16 %port16)
    ret i16 %res
  """

def outb(port: Byte, data: Byte) at io: Unit = outb(port.toShort, data)
def inb(port: Byte) at io: Byte = inb(port.toShort)

extern def outl(port: Short, data: Int) at io: Unit =
  llvm """
    %port16 = trunc i64 ${port} to i16
    %data32 = trunc i64 ${data} to i32
    call void asm sideeffect "outl $1, $0", "{dx}N,{eax},~{flags}"(i16 %port16, i32 %data32)
    ret %Pos zeroinitializer
  """

extern def inl(port: Short) at io: Int =
  llvm """
    %port16 = trunc i64 ${port} to i16
    %res = call i32 asm sideeffect "inl $1, $0", "={eax},{dx}N,~{flags}"(i16 %port16)
    %ext = zext i32 %res to i64
    ret %Int %ext
  """
