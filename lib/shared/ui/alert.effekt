import exception

import ui/pixel
import ui/vector
import ui/window
import system/calls

def alert(msg: String): Unit / { System, WindowManager } = {
  val window = do create(Vector(180.0, 140.0), colors::red)
  // TODO: write on body
  ()
}

def alert[E](proxy: on[E]) { prog: => Unit / Exception[E] }: Unit / { System, WindowManager } =
  try prog()
  with Exception[E] {
    def raise(exception: E, msg: String) = alert(msg)
  }
