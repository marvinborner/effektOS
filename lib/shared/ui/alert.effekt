import exception

import ui/window
import system/calls
import system/process

import apps/alert

def alert(text: String): Unit / Apps = {
  // val process = do spawn(alert::app) // TODO: why doesn't this work??
  val process = do spawn(App(box alert::start))
  do send(process, Message(text))
}

def alert[E](proxy: on[E]) { prog: => Unit / Exception[E] }: Unit / Apps =
  try prog()
  with Exception[E] {
    def raise(exception: E, msg: String) = alert(msg)
  }

def alert[E](proxy: on[E], msg: String) { prog: => Unit / Exception[E] }: Unit / Apps =
  try prog()
  with Exception[E] {
    def raise(exception: E, _msg: String) = alert(msg)
  }
