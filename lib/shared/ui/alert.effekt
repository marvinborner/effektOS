import exception

import ui/pixel
import ui/vector
import ui/window
import ui/truetype
import ui/geometry
import ui/compositor
import system/calls

val TEXT = 20
val BODY = Vector(320.0, 48.0)

def alert(msg: String, ?font: Font): Unit / { System, WindowManager } = {
  with on[MissingValue].panic()

  val window = do create(BODY + INSET, "Alert", colors::red)
  val area = BODY.inBody(window)
  area.geometry.write(Vector(0.0, 0.0), TEXT, msg, colors::white)
  do dirty(window, area)
}

def alert[E](proxy: on[E], ?font: Font) { prog: => Unit / Exception[E] }: Unit / { System, WindowManager } =
  try prog()
  with Exception[E] {
    def raise(exception: E, msg: String) = alert(msg)
  }
