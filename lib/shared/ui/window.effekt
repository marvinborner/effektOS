import ui/rect
import ui/pixel
import ui/vector
import ui/truetype
import ui/geometry
import ui/compositor
import system/calls
import system/process

import set

val MARGIN = 10.0
val TITLEBAR = 40.0
val TITLETEXT = 24
val INSET = Vector(0.0, TITLEBAR)

type EventKind {
  Resize(size: Vector)
  Click(position: Vector)
  Message(text: String)
  Exit()
}

type Listen {
  OnResize()
  OnClick()
  OnMessage()
  OnExit()
}

def compare(a: Listen, b: Listen) = compareStringBytes(a.show(), b.show())

effect event(ev: EventKind): Unit

def from(ev: EventKind) = ev match {
  case Resize(_)  => OnResize()
  case Click(_)   => OnClick()
  case Message(_) => OnMessage()
  case Exit()     => OnExit()
}

type WindowId = Int
record Window(id: WindowId)

interface WindowManager {
  def create(owner: Process, size: Vector, title: String, accent: Color): Window // no position!
  def size(window: Window): Vector / Exception[MissingValue]
  def resize(window: Window, size: Vector): Unit / Exception[MissingValue]
  def context(window: Window, position: Vector, size: Vector): Context / Exception[MissingValue]
  def destroy(window: Window): Unit / Exception[MissingValue]
  def remove(window: Window, context: Context): Unit / Exception[MissingValue]
  def dirty(window: Window, id: Context): Unit / Exception[MissingValue]
  def at(position: Vector): Window / Exception[MissingValue]
  def query(title: String): List[Process]
}

// TODO: remove WindowManager effect from Apps (make it an app itself)
record App(start: (=> Unit / { System, WindowManager, Apps }) at {global, io})

effect Apps = IPC[App, EventKind, Listen]

def closeButton(size: Vector) = Rect(
  Vector(size.x - TITLEBAR, 0.0) + MARGIN,
  Vector(TITLEBAR, TITLEBAR) - MARGIN * 2.0
)

def frame(geometry: Geometry, title: String, accent: Color, ?font: Font): Unit = {
  val body = Rect(Vector(0.0, 0.0), geometry.size)
  val bar = Rect(Vector(0.0, 0.0), Vector(body.size.x, TITLEBAR))
  val button = closeButton(body.size)

  geometry.fill(accent.fade(0.6))
  geometry.rectangle(bar, accent)
  geometry.rectangle(button, colors::white)
  geometry.write(Vector(MARGIN, (TITLEBAR - TITLETEXT.toDouble) / 2.0), TITLETEXT, title, colors::white)
}

// TODO: let window manager reflect on Process?
def create(size: Vector, title: String, accent: Color): Window / { WindowManager, Apps } =
  do create(do current(), size, title, accent)

def inBody(size: Vector, window: Window) = do context(window, INSET, size)

def listen(on: List[Listen]): Unit / { Apps, event } = {
  val listens = set::fromList(on, box compare)
  def go(): Unit = {
    do event(do receive(listens))
    go()
  }
  go()
}
