import x86/commands

val PORT = 1016

def putChar(ch: Char) = outb(PORT, ch.toInt.toByte)

def init() = {
	outb(PORT + 1, 0x00)
	outb(PORT + 3, 0x80)
	outb(PORT + 0, 0x03)
	outb(PORT + 1, 0x00)
	outb(PORT + 3, 0x03)
	outb(PORT + 2, 0xC7)

	// Test serial chip
	outb(PORT + 4, 0x1E) // Enable loopback
	outb(PORT + 0, 0xAE) // Write

	// Activate
	outb(PORT + 4, 0x0F)
}
